@model List<Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Employees</h1>
    <a asp-action="Create" class="btn btn-primary">Add Employee</a>
</div>

@if (TempData["Success"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (Model.Count == 0)
{
    <p class="text-muted">No employees yet. Click "Add Employee" to create the first one.</p>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Department</th>
                <th>Designation</th>
                <th class="text-end">Salary</th>
                <th>Joining Date</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.FullName</td>
                    <td>@employee.Email</td>
                    <td>@employee.Department</td>
                    <td>@employee.Designation</td>
                    <td class="text-end">@employee.Salary.ToString("N2")</td>
                    <td>@employee.JoiningDate.ToString("dd MMM yyyy")</td>
                    <td>@(employee.IsActive ? "Yes" : "No")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
