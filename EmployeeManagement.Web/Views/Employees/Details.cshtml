@model Employee
@{
    ViewData["Title"] = "Employee Details";
}

<h1 class="h3 mb-3">Employee Details</h1>

<dl class="row">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@(Model.Phone ?? "-")</dd>
    <dt class="col-sm-3">Department</dt>
    <dd class="col-sm-9">@Model.Department</dd>
    <dt class="col-sm-3">Designation</dt>
    <dd class="col-sm-9">@Model.Designation</dd>
    <dt class="col-sm-3">Salary</dt>
    <dd class="col-sm-9">@Model.Salary.ToString("N2")</dd>
    <dt class="col-sm-3">Joining Date</dt>
    <dd class="col-sm-9">@Model.JoiningDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">@(Model.IsActive ? "Yes" : "No")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
